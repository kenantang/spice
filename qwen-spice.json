_name":"MODEL","name":"MODEL","type":"MODEL","links":[80]}],"properties":{"Node name for S&R":"QwenImageDiffsynthControlnet","cnr_id":"comfy-core","ver":"0.3.51"},"widgets_values":[0.1]},{"id":145,"type":"LoadImage","pos":[-300,1050],"size":[313.87261877822516,326],"flags":{},"order":47,"mode":0,"inputs":[{"localized_name":"image","name":"image","type":"COMBO","widget":{"name":"image"},"link":null},{"localized_name":"choose file to upload","name":"upload","type":"IMAGEUPLOAD","widget":{"name":"upload"},"link":null}],"outputs":[{"localized_name":"IMAGE","name":"IMAGE","type":"IMAGE","links":[153]},{"localized_name":"MASK","name":"MASK","type":"MASK","links":[154]}],"title":"Input Image and Mask","properties":{"Node name for S&R":"LoadImage","image":"clipspace/clipspace-painted-masked-1768620303599.png [input]"},"widgets_values":["clipspace/clipspace-painted-masked-1768620303599.png [input]","image"]},{"id":161,"type":"GetNode","pos":[101.77374909873522,1422.8286670554583],"size":[210,58],"flags":{},"order":48,"mode":0,"inputs":[],"outputs":[{"name":"IMAGE","type":"IMAGE","links":[168]}],"title":"Get_Input Image","properties":{},"widgets_values":["Input Image"]},{"id":167,"type":"MarkdownNote","pos":[-300,1422.8286670554583],"size":[380.67616101954013,642.9139901130197],"flags":{},"order":49,"mode":0,"inputs":[],"outputs":[],"title":"Tutorial","properties":{},"widgets_values":["**IMPORTANT**: The SPICE workflow for Qwen Image is currently only a proof of concept. The Qwen version of SPICE has the following shortcomings:\n\n1. Qwen Image needs 50 steps to produce best results. However, 50 steps are unacceptably slow for iterative editing on most consumer GPUs. \n2. The output quality is very unstable. Specifically, it is very hard to generate realistic images when sketches are provided. This shortcoming has not been observed in the FLUX.1 [dev] and SDXL versions of SPICE. This could be due to\n   - an implementation bug (likely around differential diffusion)\n   - loss of generation capability under quantization\n   - the strength of Canny edge ControlNet being too strong\n   - underspecified style instructions in the prompt\n\nHence, Nano Banana Pro and the SDXL version of SPICE are what I commonly use for most tasks (January 2026). My suggestions are:\n1. If you are interested in using this workflow for academic reasons, I would love to discuss next steps with you.\n2. If you want to use SPICE for production, I kindly suggest that you use the FLUX.1 [dev] and SDXL versions of SPICE instead. I have tested those versions for hundreds of hours, and the results are much more stable than the Qwen version.\n\nTo edit an image, take the following steps:\n1. Load all models. \n   - The base model, CLIP model, and VAE model can be download at [this link](https://docs.comfy.org/tutorials/image/qwen/qwen-image).\n    - The Canny edge ControlNet model can be downloaded at [this link](https://docs.comfy.org/tutorials/image/qwen/qwen-image#qwen-image-controlnet-diffsynth-controlnets-model-patches-workflow). Note that the ControlNet is not compatible with the 2512 version.\n    - The LoRA can be downloaded at [this link](https://civitai.com/models/1662740?modelVersionId=2106185). \n2. Upload image and draw a mask. Make sure the context dots are added to extend the inpainting context.\n3. Click \"Run\" to start generation.\n4. If the results are not ideal, tune two main parameters to get potentially better results:\n   - The `Denoising Strength` controls how the output is similar to the input image. If the inpainted result changes the original texture too much (i.e., there is a seam between the inpainted region and the original image), the denoising strength can be reduced.\n   - The `First Stage Steps` controls how much the edges in the generated image align with ones in the input. If stronger edge control is needed, increase this number. Additionally, the `strength` parameter in the `QwenImageDiffsynthControlnet` node can also be increased."],"color":"#432","bgcolor":"#653"}],"links":[[44,29,0,30,0,"IMAGE"],[45,30,0,31,3,"IMAGE"],[51,36,0,28,1,"GUIDER"],[59,42,0,44,0,"SIGMAS"],[69,48,0,49,1,"GUIDER"],[76,49,1,54,0,"LATENT"],[77,45,0,56,0,"STITCHER"],[80,31,0,58,0,"MODEL"],[81,58,0,36,0,"MODEL"],[82,59,0,48,0,"MODEL"],[85,61,2,28,4,"LATENT"],[98,71,0,72,0,"VAE"],[99,74,0,31,2,"VAE"],[102,76,0,78,0,"CONDITIONING"],[103,77,0,79,0,"CONDITIONING"],[104,80,0,61,0,"CONDITIONING"],[105,81,0,61,1,"CONDITIONING"],[106,82,0,36,1,"CONDITIONING"],[107,83,0,36,2,"CONDITIONING"],[108,85,0,48,1,"CONDITIONING"],[109,84,0,48,2,"CONDITIONING"],[110,86,0,54,1,"VAE"],[111,54,0,87,0,"IMAGE"],[112,88,0,56,1,"IMAGE"],[113,89,0,61,2,"VAE"],[114,44,0,90,0,"SIGMAS"],[115,91,0,28,3,"SIGMAS"],[116,44,1,92,0,"SIGMAS"],[117,94,0,49,3,"SIGMAS"],[118,95,0,96,0,"SAMPLER"],[119,97,0,28,2,"SAMPLER"],[120,98,0,49,2,"SAMPLER"],[121,99,0,100,0,"NOISE"],[122,101,0,28,0,"NOISE"],[123,102,0,49,0,"NOISE"],[126,105,0,106,0,"MODEL_PATCH"],[127,107,0,31,1,"MODEL_PATCH"],[128,45,1,108,0,"IMAGE"],[129,109,0,61,3,"IMAGE"],[130,110,0,29,0,"IMAGE"],[131,45,2,111,0,"MASK"],[132,112,0,61,4,"MASK"],[133,30,0,114,0,"IMAGE"],[134,115,0,60,0,"IMAGE"],[135,43,0,118,0,"MODEL"],[136,118,0,69,0,"MODEL"],[137,123,0,124,0,"STRING"],[139,75,0,126,0,"CLIP"],[140,127,0,76,0,"CLIP"],[141,128,0,77,0,"CLIP"],[142,129,0,76,1,"STRING"],[144,131,0,132,0,"INT"],[145,133,0,99,0,"INT"],[147,136,0,44,1,"INT"],[148,137,0,138,0,"INT"],[149,140,0,134,0,"INT"],[150,139,0,142,0,"FLOAT"],[151,143,0,42,2,"INT"],[152,144,0,42,3,"FLOAT"],[153,145,0,146,0,"IMAGE"],[154,145,1,147,0,"MASK"],[155,56,0,148,0,"IMAGE"],[156,149,0,57,0,"IMAGE"],[157,150,0,45,0,"IMAGE"],[158,151,0,45,1,"MASK"],[159,153,0,155,0,"INT"],[160,152,0,154,0,"INT"],[168,161,0,162,1,"IMAGE"],[169,149,0,162,0,"IMAGE"],[170,163,0,31,0,"MODEL"],[171,164,0,59,0,"MODEL"],[172,165,0,166,0,"MODEL"],[173,166,0,42,0,"MODEL"],[175,28,1,49,4,"LATENT"]],"groups":[{"id":1,"title":"[Step 1] Load Models and Define Parameters with Set 